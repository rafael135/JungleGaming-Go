# ==============================================================================
# Jungle Gaming - Local Environment Configuration
# ==============================================================================

# Application Server
PORT=8081
ENVIRONMENT=development
LOG_LEVEL=debug

# PostgreSQL Database
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle_secret
POSTGRES_DB=jungle_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://jungle:jungle_secret@localhost:5432/jungle_db?sslmode=disable

# AWS / LocalStack SQS Configuration
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Inbound queues (Section 10)
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# Outbound outbox event queues (Section 11)
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_EVENTS_DLQ_URL=http://localhost:4566/000000000000/wager-events-dlq.fifo

# Keycloak / OAuth 2.0 / OIDC
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=jungle
KEYCLOAK_ISSUER=http://localhost:8080/realms/jungle
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/jungle/protocol/openid-connect/certs

# Test Client Credentials
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-secret

PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-secret

INTERNAL_CLIENT_ID=internal-service
INTERNAL_CLIENT_SECRET=internal-service-secret

